  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" charger\nnon\nnouvelle\noui\nretour" ,fontname="Helvetica"];
  Node3 [label="Btn",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structBtn.html",tooltip=" "];
